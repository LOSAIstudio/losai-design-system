{
  "name": "losai-design-system",
  "version": "3.0.0",
  "private": false,
  "description": "LOSAI studio design system — React + TypeScript components, tokens, and stylesheet. Architecture & Design · New York.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles/losai.css": "./src/styles/losai.css",
    "./tailwind.preset": {
      "types": "./dist/tailwind.preset.d.ts",
      "import": "./dist/tailwind.preset.js"
    }
  },
  "files": [
    "dist",
    "src/styles/losai.css",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:lib": "tsc -p tsconfig.build.json",
    "build": "npm run build:lib",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  },
  "keywords": [
    "losai",
    "design-system",
    "react",
    "typescript",
    "tokens"
  ]
}
